# --- Discord application credentials ---------------------------------------
# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-oauth2-client-secret

# --- OAuth2 ------------------------------------------------------------------
# Must match EXACTLY one of the redirect URIs registered under OAuth2 in the
# developer portal. For local testing use a tunnel (ngrok/cloudflared) — Discord
# will not redirect to a bare localhost URL over https.
OAUTH_REDIRECT_URI=https://your-domain.example/callback

# Public base URL the bot hands out in the opt-in message.
PUBLIC_BASE_URL=https://your-domain.example

# --- Safety bound ------------------------------------------------------------
# Comma-separated guild IDs that /join is allowed to target. This is the whole
# point of the allowlist: members consent to being added to THESE servers, and
# the bot physically cannot add them anywhere else. Required, no default.
ALLOWED_TARGET_GUILDS=123456789012345678

# --- Storage -----------------------------------------------------------------
# 32 bytes of hex. Generate with: npm run gen-key
# Encrypts the stored OAuth tokens at rest.
ENCRYPTION_KEY=

DATA_FILE=./data/consents.json
PORT=3000

# Optional: register slash commands instantly in one guild instead of waiting
# up to an hour for global propagation. Handy while developing.
DEV_GUILD_ID=
