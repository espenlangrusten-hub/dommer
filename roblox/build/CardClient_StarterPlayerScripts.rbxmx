<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="LocalScript" referent="RBX1">
		<Properties>
			<string name="Name">CardClient</string>
			<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CardSystem client
	Owns the roll button, spawns the 3D hand in front of the camera, drives
	every card from one render pass, and reports the player's pick to the
	server.

	The client never decides what is rolled - it only renders what the server
	sends and asks for a slot.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")

local CardSystem = ReplicatedStorage:WaitForChild("CardSystem")
local Cards = require(CardSystem:WaitForChild("Cards"))
local Config = require(CardSystem:WaitForChild("Config"))
local Rarities = require(CardSystem:WaitForChild("Rarities"))
local Remotes = require(CardSystem:WaitForChild("Remotes")).get()

local CardVisual = require(script:WaitForChild("CardVisual"))
local RollUI = require(script:WaitForChild("RollUI"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local HAND_FOLDER_NAME = "CardHand"
local RAY_LENGTH = 500
local UNHOVERED_TILT = 0.5 -- neighbours tilt less than the card under the cursor

-- State ------------------------------------------------------------------
type State = "idle" | "requesting" | "choosing" | "resolving" | "cooldown"

local ui = RollUI.new()
local visuals: { CardVisual.CardVisual } = {}
local handFolder: Folder? = nil
local state: State = "idle"
local activeRollId: number? = nil
local stateToken = 0

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Include
raycastParams.IgnoreWater = true
raycastParams.FilterDescendantsInstances = {}

-- Helpers ----------------------------------------------------------------
local function playSound(id: string)
	if id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = 0.5
	sound.PlayOnRemove = true
	sound.Parent = SoundService
	sound:Destroy()
end

local function setState(newState: State)
	state = newState
	stateToken += 1
end

local function currentTokenGuard(): () -> boolean
	local token = stateToken
	return function()
		return token == stateToken
	end
end

local function refreshFilter()
	local parts: { Instance } = {}
	for _, visual in visuals do
		table.insert(parts, visual.Part)
	end
	raycastParams.FilterDescendantsInstances = parts
end

local function clearHand()
	for _, visual in visuals do
		visual:destroy()
	end
	table.clear(visuals)
	refreshFilter()
	if handFolder then
		handFolder:Destroy()
		handFolder = nil
	end
end

-- Where the hand sits: frozen in world space at the moment of the roll, so
-- the cards stay put if the player turns the camera.
local function handOrigin(): CFrame
	local cf = camera.CFrame
	return cf * CFrame.new(0, Config.CameraHeightOffset, -Config.CameraDistance)
end

local function spawnHand(cardIds: { string })
	clearHand()
	camera = workspace.CurrentCamera -- may have been replaced since the last hand

	local folder = Instance.new("Folder")
	folder.Name = HAND_FOLDER_NAME
	folder.Parent = workspace
	handFolder = folder

	local origin = handOrigin()
	local eye = camera.CFrame.Position
	local count = #cardIds
	local middle = (count + 1) / 2

	for slot, cardId in cardIds do
		local card = Cards.get(cardId)
		if not card then
			warn(`[CardSystem] server sent unknown card "{cardId}"`)
			continue
		end

		local offset = (slot - middle) * Config.CardSpacing
		local position = origin.Position + origin.RightVector * offset
		-- lookAt puts the part's Front face (its -Z) toward the camera.
		local base = CFrame.lookAt(position, eye)

		table.insert(visuals, CardVisual.new(card, slot, base, folder))
	end

	refreshFilter()
	playSound(Config.Sounds.Roll)
end

local function cardUnderPoint(screenX: number, screenY: number): CardVisual.CardVisual?
	if #visuals == 0 then
		return nil
	end
	local ray = camera:ViewportPointToRay(screenX, screenY)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
	if not hit then
		return nil
	end
	for _, visual in visuals do
		if visual.Part == hit.Instance then
			return visual
		end
	end
	return nil
end

-- Roll -------------------------------------------------------------------
local function requestRoll()
	if state ~= "idle" then
		return
	end
	setState("requesting")
	ui:setEnabled(false, "...")
	ui:setStatus("Dealing...")
	Remotes.RequestRoll:FireServer()

	-- Never leave the button dead if the reply is lost. The guard only holds
	-- while no other state change happened, so it still being true here means
	-- the request was never answered.
	local guard = currentTokenGuard()
	task.delay(5, function()
		if guard() then
			setState("idle")
			ui:setEnabled(true)
			ui:setStatus("No answer from the server, try again")
		end
	end)
end

ui.OnRoll = requestRoll

local function selectCard(visual: CardVisual.CardVisual)
	if state ~= "choosing" or activeRollId == nil then
		return
	end
	if not visual:isInteractive() then
		return
	end

	setState("resolving")
	ui:setStatus("...")
	Remotes.SelectCard:FireServer(activeRollId, visual.Slot)
end

-- Remote handlers --------------------------------------------------------
Remotes.RollResult.OnClientEvent:Connect(function(rollId: number, cardIds: { string })
	activeRollId = rollId
	setState("choosing")
	spawnHand(cardIds)
	ui:setEnabled(false, "PICK")
	ui:setStatus("Click a card to keep it")
end)

Remotes.RollRejected.OnClientEvent:Connect(function(reason: string, retryAfter: number)
	if state == "choosing" or state == "resolving" then
		-- A stale request; the hand on screen is still the one that matters.
		ui:setStatus(reason)
		return
	end

	ui:setStatus(reason)
	if retryAfter > 0.05 then
		setState("cooldown")
		local guard = currentTokenGuard()
		ui:runCooldown(retryAfter, guard)
		task.delay(retryAfter, function()
			if guard() then
				setState("idle")
				ui:setStatus(`Roll for {Config.CardsPerRoll} cards`)
			end
		end)
	else
		setState("idle")
		ui:setEnabled(true)
	end
end)

Remotes.SelectionResult.OnClientEvent:Connect(function(ok: boolean, cardId: string?, slot: number?)
	if not ok then
		-- Server refused the pick: hand the choice back rather than freezing.
		if state == "resolving" then
			setState("choosing")
			ui:setStatus("That pick did not go through, try again")
		end
		return
	end

	local card = if cardId then Cards.get(cardId) else nil
	activeRollId = nil

	for _, visual in visuals do
		visual:beginExit(if visual.Slot == slot then "chosen" else "discarded")
	end

	if card then
		local rarity = Rarities.get(card.Rarity)
		ui:showBanner(card.Name, rarity)
		playSound(if rarity.Sparkle then Config.Sounds.Rare else Config.Sounds.Select)
	end

	setState("cooldown")
	local guard = currentTokenGuard()
	ui:setStatus("Added to your collection")
	ui:runCooldown(Config.RollCooldown, guard)
	task.delay(Config.RollCooldown, function()
		if guard() then
			setState("idle")
			ui:setStatus(`Roll for {Config.CardsPerRoll} cards`)
		end
	end)
end)

-- Input ------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed or state ~= "choosing" then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local visual = cardUnderPoint(input.Position.X, input.Position.Y)
	if visual then
		selectCard(visual)
	end
end)

ContextActionService:BindAction("CardSystemRoll", function(_, inputState: Enum.UserInputState)
	if inputState == Enum.UserInputState.Begin and state == "idle" then
		requestRoll()
	end
	return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.R)

-- Render -----------------------------------------------------------------
RunService.RenderStepped:Connect(function(dt: number)
	if #visuals == 0 then
		return
	end

	camera = workspace.CurrentCamera
	local viewport = camera.ViewportSize
	local mouse = UserInputService:GetMouseLocation()

	local hovered: CardVisual.CardVisual? = nil
	if state == "choosing" then
		hovered = cardUnderPoint(mouse.X, mouse.Y)
	end

	for index = #visuals, 1, -1 do
		local visual = visuals[index]

		local screenPoint = camera:WorldToViewportPoint(visual.Part.Position)
		local dx = math.clamp((mouse.X - screenPoint.X) / (viewport.X * 0.5), -1, 1)
		local dy = math.clamp((mouse.Y - screenPoint.Y) / (viewport.Y * 0.5), -1, 1)
		-- Screen Y grows downward, so the pitch is inverted to lean the card
		-- toward the cursor rather than away from it.
		local tilt = Vector2.new(dx, -dy)

		local isHovered = hovered == visual
		if not isHovered then
			tilt *= UNHOVERED_TILT
		end

		visual:update(dt, tilt, isHovered)

		if visual:isFinished() then
			visual:destroy()
			table.remove(visuals, index)
			refreshFilter()
		end
	end

	if #visuals == 0 and handFolder then
		handFolder:Destroy()
		handFolder = nil
	end
end)

--[[
	Respawning teleports the camera away from an un-picked hand, which would
	strand the pending roll on the server. Move the hand to the new camera
	instead of deleting it.
]]
local function repositionHand()
	if #visuals == 0 then
		return
	end
	local origin = handOrigin()
	local eye = camera.CFrame.Position
	local middle = (#visuals + 1) / 2
	for index, visual in visuals do
		local offset = (index - middle) * Config.CardSpacing
		local position = origin.Position + origin.RightVector * offset
		visual.BaseCFrame = CFrame.lookAt(position, eye)
	end
end

player.CharacterAdded:Connect(function(character: Model)
	if state ~= "choosing" then
		return
	end
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.5) -- let the camera settle on the new spawn
	if state == "choosing" then
		camera = workspace.CurrentCamera
		repositionHand()
	end
end)

ui:setEnabled(true)
]]></ProtectedString>
		</Properties>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">CardVisual</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CardVisual
	One 3D card: an anchored Part with a SurfaceGui on each face.

	Nothing here uses TweenService for the CFrame. The controller drives every
	card from a single RenderStepped pass, so entrance, flip, cursor tilt and
	hover compose into one transform instead of fighting each other.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardSystem = ReplicatedStorage:WaitForChild("CardSystem")
local Cards = require(CardSystem:WaitForChild("Cards"))
local Config = require(CardSystem:WaitForChild("Config"))
local Rarities = require(CardSystem:WaitForChild("Rarities"))

type Card = Cards.Card

local BACKDROP = Color3.fromRGB(16, 17, 22)
local PANEL = Color3.fromRGB(26, 28, 36)

-- Easing -----------------------------------------------------------------
local function clamp01(n: number): number
	return math.clamp(n, 0, 1)
end

local function easeOutCubic(t: number): number
	return 1 - (1 - t) ^ 3
end

local function easeOutBack(t: number): number
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

local function easeInOutCubic(t: number): number
	return if t < 0.5 then 4 * t ^ 3 else 1 - (-2 * t + 2) ^ 3 / 2
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Instance helper --------------------------------------------------------
local function make(className: string, props: { [string]: any }, children: { any }?): any
	local instance = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	-- Parent last: setting it first makes Roblox replicate every later property.
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- Face building ----------------------------------------------------------
local function diagonalSheen(): Instance
	-- The soft X-fold shading the reference cards use.
	return make("Frame", {
		Name = "Sheen",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
	}, {
		make("Frame", {
			Name = "A",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1.6, 0.5),
			Rotation = 34,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.94,
			BorderSizePixel = 0,
		}),
		make("Frame", {
			Name = "B",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1.6, 0.5),
			Rotation = -34,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.94,
			BorderSizePixel = 0,
		}),
	})
end

local function buildFront(card: Card, rarity: Rarities.Rarity): CanvasGroup
	local iconHolder: Instance
	if card.Icon ~= "" then
		iconHolder = make("ImageLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			Image = card.Icon,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.07),
			Size = UDim2.fromScale(0.64, 0.3),
		})
	else
		-- No art yet: draw the card's initial so the layout still reads.
		iconHolder = make("TextLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.07),
			Size = UDim2.fromScale(0.64, 0.3),
			Font = Enum.Font.GothamBold,
			Text = string.upper(string.sub(card.Name, 1, 1)),
			TextColor3 = rarity.Color,
			TextScaled = true,
			TextTransparency = 0.25,
		})
	end

	return make("CanvasGroup", {
		Name = "Face",
		BackgroundColor3 = PANEL,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1,
		ClipsDescendants = true,
	}, {
		make("UICorner", { CornerRadius = UDim.new(0.04, 0) }),
		make("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(44, 46, 58)),
				ColorSequenceKeypoint.new(0.55, Color3.fromRGB(22, 23, 30)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 12, 16)),
			}),
		}),
		make("UIStroke", {
			Name = "Border",
			Color = rarity.Color,
			Thickness = 5,
			Transparency = 0.05,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		diagonalSheen(),
		-- Rarity wash behind the icon.
		make("Frame", {
			Name = "Wash",
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 0.42),
		}, {
			make("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.35),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		}),
		iconHolder,
		make("TextLabel", {
			Name = "CardName",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.4),
			Size = UDim2.fromScale(0.88, 0.09),
			Font = Enum.Font.GothamBold,
			Text = card.Name,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextScaled = true,
		}, {
			make("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 2, Transparency = 0.45 }),
		}),
		make("TextLabel", {
			Name = "RarityLabel",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.505),
			Size = UDim2.fromScale(0.8, 0.07),
			Font = Enum.Font.GothamBold,
			Text = rarity.Name,
			TextColor3 = rarity.TextColor,
			TextScaled = true,
		}, {
			make("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 2, Transparency = 0.5 }),
		}),
		make("Frame", {
			Name = "Divider",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.6),
			Size = UDim2.fromScale(0.6, 0.006),
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
		}),
		make("TextLabel", {
			Name = "Flavor",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.63),
			Size = UDim2.fromScale(0.82, 0.16),
			Font = Enum.Font.SourceSansItalic,
			Text = card.Flavor,
			TextColor3 = Color3.fromRGB(214, 218, 228),
			TextScaled = true,
			TextWrapped = true,
		}),
		-- Footer call to action.
		make("Frame", {
			Name = "Footer",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.955),
			Size = UDim2.fromScale(0.72, 0.075),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
		}, {
			make("UICorner", { CornerRadius = UDim.new(0.3, 0) }),
			make("UIStroke", { Color = rarity.Color, Thickness = 2, Transparency = 0.55 }),
			make("TextLabel", {
				Name = "Prompt",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Font = Enum.Font.GothamMedium,
				Text = "Click to Select",
				TextColor3 = Color3.fromRGB(236, 239, 245),
				TextScaled = true,
			}, {
				make("UIPadding", {
					PaddingTop = UDim.new(0.2, 0),
					PaddingBottom = UDim.new(0.2, 0),
				}),
			}),
		}),
	})
end

local function buildBack(): CanvasGroup
	return make("CanvasGroup", {
		Name = "Back",
		BackgroundColor3 = Color3.fromRGB(20, 21, 28),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1,
		ClipsDescendants = true,
	}, {
		make("UICorner", { CornerRadius = UDim.new(0.04, 0) }),
		make("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(38, 40, 52), Color3.fromRGB(12, 12, 17)),
		}),
		make("UIStroke", {
			Color = Color3.fromRGB(92, 98, 116),
			Thickness = 4,
			Transparency = 0.3,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		diagonalSheen(),
		make("Frame", {
			Name = "Emblem",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.34, 0.24),
			Rotation = 45,
			BackgroundColor3 = Color3.fromRGB(120, 128, 150),
			BackgroundTransparency = 0.75,
			BorderSizePixel = 0,
		}, {
			make("UIStroke", { Color = Color3.fromRGB(160, 168, 190), Thickness = 2, Transparency = 0.5 }),
		}),
	})
end

-- Class ------------------------------------------------------------------
local CardVisual = {}
CardVisual.__index = CardVisual

export type CardVisual = typeof(setmetatable(
	{} :: {
		Card: Card,
		Rarity: Rarities.Rarity,
		Slot: number,
		Part: BasePart,
		BaseCFrame: CFrame,
		StartTime: number,
		EnterDelay: number,
		FlipDelay: number,
		State: string,
		ExitStart: number,
		ExitMode: string,
		Revealed: boolean,
		Tilt: Vector2,
		Hover: number,
		Front: CanvasGroup,
		BackFace: CanvasGroup,
		Light: PointLight,
		Glow: Highlight,
		Sparks: ParticleEmitter,
	},
	CardVisual
))

function CardVisual.new(card: Card, slot: number, baseCFrame: CFrame, parent: Instance): CardVisual
	local rarity = Rarities.get(card.Rarity)

	local part = make("Part", {
		Name = `Card_{card.Id}`,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = true, -- the controller raycasts against this
		CastShadow = false,
		Material = Enum.Material.SmoothPlastic,
		Color = BACKDROP,
		Transparency = 1,
		Size = Config.CardSize,
		CFrame = baseCFrame,
	}) :: BasePart

	local front = buildFront(card, rarity)
	local back = buildBack()

	make("SurfaceGui", {
		Name = "FrontGui",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = Config.PixelsPerStud,
		LightInfluence = 0,
		Brightness = 1.4,
		MaxDistance = 250,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = part,
	}, { front })

	make("SurfaceGui", {
		Name = "BackGui",
		Face = Enum.NormalId.Back,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = Config.PixelsPerStud,
		LightInfluence = 0,
		Brightness = 1.2,
		MaxDistance = 250,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = part,
	}, { back })

	local light = make("PointLight", {
		Color = rarity.GlowColor,
		Brightness = 0,
		Range = 10,
		Shadows = false,
		Parent = part,
	}) :: PointLight

	local glow = make("Highlight", {
		Name = "Hover",
		Adornee = part,
		FillTransparency = 1,
		OutlineColor = rarity.GlowColor,
		OutlineTransparency = 1,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Parent = part,
	}) :: Highlight

	local attachment = make("Attachment", { Name = "SparkPoint", Parent = part }) :: Attachment
	local sparks = make("ParticleEmitter", {
		Name = "Sparks",
		Enabled = false,
		Color = ColorSequence.new(rarity.GlowColor),
		LightEmission = 1,
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(180, 180),
		Rate = 0,
		Rotation = NumberRange.new(0, 360),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = attachment,
	}) :: ParticleEmitter

	part.Parent = parent

	local self = setmetatable({
		Card = card,
		Rarity = rarity,
		Slot = slot,
		Part = part,
		BaseCFrame = baseCFrame,
		StartTime = os.clock(),
		EnterDelay = (slot - 1) * Config.EnterStagger,
		FlipDelay = Config.EnterDuration + (slot - 1) * Config.FlipStagger + rarity.RevealDelay,
		State = "entering",
		ExitStart = 0,
		ExitMode = "discarded",
		Revealed = false,
		Tilt = Vector2.zero,
		Hover = 0,
		Front = front,
		BackFace = back,
		Light = light,
		Glow = glow,
		Sparks = sparks,
	}, CardVisual)

	return (self :: any) :: CardVisual
end

function CardVisual.isInteractive(self: CardVisual): boolean
	return self.Revealed and self.State ~= "exiting"
end

function CardVisual.beginExit(self: CardVisual, mode: string)
	if self.State == "exiting" then
		return
	end
	self.State = "exiting"
	self.ExitMode = mode
	self.ExitStart = os.clock()
end

function CardVisual.isFinished(self: CardVisual): boolean
	return self.State == "exiting" and os.clock() - self.ExitStart > Config.ExitDuration
end

--[[
	One frame of animation.
	tiltTarget: -1..1 on each axis, how far the cursor sits from the card.
	hovered: is the cursor actually over this card.
]]
function CardVisual.update(self: CardVisual, dt: number, tiltTarget: Vector2, hovered: boolean)
	local now = os.clock()
	local elapsed = now - self.StartTime

	local enter = clamp01((elapsed - self.EnterDelay) / Config.EnterDuration)
	local enterEase = easeOutBack(enter)
	local flip = clamp01((elapsed - self.FlipDelay) / Config.FlipDuration)
	local flipEase = easeInOutCubic(flip)

	if flip >= 1 and not self.Revealed then
		self.Revealed = true
		if self.Rarity.Sparkle then
			self.Sparks:Emit(28 + self.Rarity.Rank * 8)
		end
	end

	-- Cursor tilt and hover only once the face is up.
	local interactive = self.Revealed and self.State ~= "exiting"
	local wantHover = if interactive and hovered then 1 else 0
	local smoothing = clamp01(dt * Config.TiltSmoothing)
	local tiltWeight = if interactive then 1 else 0
	self.Tilt = self.Tilt:Lerp(tiltTarget * tiltWeight, smoothing)
	self.Hover = lerp(self.Hover, wantHover, smoothing)

	local scale = lerp(Config.EnterScale, 1, math.min(enterEase, 1))
	scale *= lerp(1, Config.HoverScale, self.Hover)

	local rise = (1 - easeOutCubic(enter)) * -Config.EnterDrop + self.Hover * Config.HoverLift
	local alpha = 1 - enter
	local pushToCamera = self.Hover * Config.HoverPop

	if self.State == "exiting" then
		local exit = clamp01((now - self.ExitStart) / Config.ExitDuration)
		local exitEase = easeOutCubic(exit)
		alpha = math.max(alpha, exitEase)
		if self.ExitMode == "chosen" then
			pushToCamera += exitEase * 5
			scale *= lerp(1, 1.35, exitEase)
		else
			rise -= exitEase * 3
			scale *= lerp(1, 0.85, exitEase)
		end
	end

	local flipAngle = math.pi * (1 - flipEase)

	local cframe = CFrame.new(0, rise, 0)
		* self.BaseCFrame
		* CFrame.Angles(0, flipAngle, 0)
		* CFrame.Angles(self.Tilt.Y * Config.MaxTilt, self.Tilt.X * Config.MaxTilt, 0)
		* CFrame.new(0, 0, -pushToCamera)

	self.Part.CFrame = cframe
	self.Part.Size = Config.CardSize * scale
	self.Part.Transparency = alpha

	self.Front.GroupTransparency = alpha
	self.BackFace.GroupTransparency = alpha

	self.Light.Brightness = self.Rarity.GlowBrightness * flipEase * (1 - alpha)
	self.Glow.OutlineTransparency = 1 - self.Hover * 0.85
end

function CardVisual.destroy(self: CardVisual)
	self.Part:Destroy()
end

return CardVisual
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">RollUI</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RollUI
	Bottom-centre ROLL button, a status line above it, an odds strip, and the
	"you got X" banner shown after a pick.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local CardSystem = ReplicatedStorage:WaitForChild("CardSystem")
local Config = require(CardSystem:WaitForChild("Config"))
local Rarities = require(CardSystem:WaitForChild("Rarities"))

local IDLE_COLOR = Color3.fromRGB(96, 132, 255)
local BUSY_COLOR = Color3.fromRGB(58, 62, 78)
local BUTTON_WIDTH = 236
local BUTTON_HEIGHT = 62

local function make(className: string, props: { [string]: any }, children: { any }?): any
	local instance = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local RollUI = {}
RollUI.__index = RollUI

export type RollUI = typeof(setmetatable(
	{} :: {
		Gui: ScreenGui,
		Button: TextButton,
		ButtonLabel: TextLabel,
		Status: TextLabel,
		Banner: Frame,
		BannerLabel: TextLabel,
		Stroke: UIStroke,
		Enabled: boolean,
		OnRoll: (() -> ())?,
	},
	RollUI
))

local function buildOdds(): Frame
	local row = make("Frame", {
		Name = "Odds",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(0, 540, 0, 18),
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	for index, rarity in Rarities.List do
		local percent = Rarities.chancePercent(rarity.Id)
		local text = if percent >= 1
			then `{rarity.Name} {string.format("%.0f", percent)}%`
			else `{rarity.Name} {string.format("%.2f", percent)}%`

		make("TextLabel", {
			Name = rarity.Id,
			LayoutOrder = index,
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			Font = Enum.Font.GothamMedium,
			Text = text,
			TextSize = 12,
			TextColor3 = rarity.TextColor,
			TextTransparency = 0.25,
			Parent = row,
		}, {
			make("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 2, Transparency = 0.55 }),
		})
	end

	return row
end

function RollUI.new(): RollUI
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local gui = make("ScreenGui", {
		Name = "CardRollUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
	}) :: ScreenGui

	local dock = make("Frame", {
		Name = "Dock",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(0, 560, 0, 132),
		Parent = gui,
	})

	local status = make("TextLabel", {
		Name = "Status",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.new(1, 0, 0, 20),
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(226, 230, 240),
		Parent = dock,
	}, {
		make("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 2, Transparency = 0.4 }),
	}) :: TextLabel

	local buttonLabel = make("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBold,
		Text = "ROLL",
		TextSize = 26,
		TextColor3 = Color3.fromRGB(255, 255, 255),
	}) :: TextLabel

	local stroke = make("UIStroke", {
		Color = Color3.fromRGB(150, 180, 255),
		Thickness = 2,
		Transparency = 0.2,
	}) :: UIStroke

	local button = make("TextButton", {
		Name = "RollButton",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 28),
		Size = UDim2.new(0, BUTTON_WIDTH, 0, BUTTON_HEIGHT),
		BackgroundColor3 = IDLE_COLOR,
		AutoButtonColor = false,
		Text = "",
		Parent = dock,
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 14) }),
		make("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 195, 215)),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.7),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
		stroke,
		buttonLabel,
	}) :: TextButton

	buildOdds().Parent = dock

	local bannerLabel = make("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBold,
		Text = "",
		TextSize = 20,
		TextColor3 = Color3.fromRGB(255, 255, 255),
	}, {
		make("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 2, Transparency = 0.4 }),
	}) :: TextLabel

	local banner = make("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.new(0, 380, 0, 52),
		BackgroundColor3 = Color3.fromRGB(14, 15, 20),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 12) }),
		make("UIStroke", { Name = "Edge", Color = Color3.fromRGB(255, 255, 255), Thickness = 2, Transparency = 1 }),
		bannerLabel,
	}) :: Frame

	gui.Parent = playerGui

	local self = setmetatable({
		Gui = gui,
		Button = button,
		ButtonLabel = buttonLabel,
		Status = status,
		Banner = banner,
		BannerLabel = bannerLabel,
		Stroke = stroke,
		Enabled = true,
		OnRoll = nil,
	}, RollUI)

	button.MouseButton1Click:Connect(function()
		if self.Enabled and self.OnRoll then
			self.OnRoll()
		end
	end)

	local function scaleTo(scale: number)
		TweenService:Create(button, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {
			Size = UDim2.new(0, math.floor(BUTTON_WIDTH * scale), 0, math.floor(BUTTON_HEIGHT * scale)),
		}):Play()
	end

	button.MouseEnter:Connect(function()
		if self.Enabled then
			scaleTo(1.04)
		end
	end)
	button.MouseLeave:Connect(function()
		scaleTo(1)
	end)
	button.MouseButton1Down:Connect(function()
		if self.Enabled then
			scaleTo(0.96)
		end
	end)
	button.MouseButton1Up:Connect(function()
		scaleTo(1)
	end)

	self:setStatus(`Roll for {Config.CardsPerRoll} cards`)

	return (self :: any) :: RollUI
end

function RollUI.setEnabled(self: RollUI, enabled: boolean, label: string?)
	local changed = self.Enabled ~= enabled
	self.Enabled = enabled
	self.ButtonLabel.Text = label or "ROLL"
	self.ButtonLabel.TextTransparency = if enabled then 0 else 0.35

	-- The cooldown calls this ten times a second; only recolour on a real
	-- state change so it is not spawning a tween every tick.
	if changed then
		TweenService:Create(self.Button, TweenInfo.new(0.18), {
			BackgroundColor3 = if enabled then IDLE_COLOR else BUSY_COLOR,
		}):Play()
		self.Stroke.Transparency = if enabled then 0.2 else 0.75
	end
end

function RollUI.setStatus(self: RollUI, text: string)
	self.Status.Text = text
end

--[[
	Counts the cooldown down on the button face, then re-enables it.
	`isCurrent` returns false when a newer state took over, so a stale
	countdown never re-enables the button behind the caller's back.
]]
function RollUI.runCooldown(self: RollUI, seconds: number, isCurrent: () -> boolean)
	task.spawn(function()
		local remaining = seconds
		while remaining > 0 do
			if not isCurrent() then
				return
			end
			self:setEnabled(false, string.format("%.1fs", remaining))
			remaining -= task.wait(0.1)
		end
		if isCurrent() then
			self:setEnabled(true)
		end
	end)
end

function RollUI.showBanner(self: RollUI, cardName: string, rarity: Rarities.Rarity)
	local banner = self.Banner
	local edge = banner:FindFirstChild("Edge") :: UIStroke
	self.BannerLabel.Text = `{cardName}  -  {rarity.Name}`
	self.BannerLabel.TextColor3 = rarity.TextColor
	edge.Color = rarity.Color
	banner.Visible = true
	banner.BackgroundTransparency = 1
	self.BannerLabel.TextTransparency = 1
	edge.Transparency = 1

	local inInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(banner, inInfo, { BackgroundTransparency = 0.15 }):Play()
	TweenService:Create(self.BannerLabel, inInfo, { TextTransparency = 0 }):Play()
	TweenService:Create(edge, inInfo, { Transparency = 0.1 }):Play()

	task.delay(2.4, function()
		local outInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(banner, outInfo, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(self.BannerLabel, outInfo, { TextTransparency = 1 }):Play()
		local fade = TweenService:Create(edge, outInfo, { Transparency = 1 })
		fade.Completed:Connect(function()
			banner.Visible = false
		end)
		fade:Play()
	end)
end

return RollUI
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
