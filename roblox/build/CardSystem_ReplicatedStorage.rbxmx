<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBX1">
		<Properties>
			<string name="Name">CardSystem</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Config
	Every tunable number for the card roll system lives here.
	Shared between server and client, so both agree on timings.
]]

local Config = {
	-- Roll rules -------------------------------------------------------
	CardsPerRoll = 3, -- how many cards are dealt each roll
	RollCooldown = 2, -- seconds a player must wait between rolls
	PityRolls = 12, -- rolls without a Rare+ before one is guaranteed (0 disables)
	PityMinimumRarity = "Rare",

	-- Card geometry (studs) --------------------------------------------
	CardSize = Vector3.new(3.8, 5.3, 0.16),
	CardSpacing = 4.3, -- centre-to-centre distance between cards
	CameraDistance = 9, -- how far in front of the camera the hand spawns
	CameraHeightOffset = 0.4, -- lift the hand slightly above eye level
	PixelsPerStud = 110, -- SurfaceGui resolution

	-- Animation ---------------------------------------------------------
	EnterDuration = 0.45,
	EnterStagger = 0.13, -- delay between each card entering
	EnterDrop = 4, -- studs the card rises from
	EnterScale = 0.82, -- starting size multiplier
	FlipDuration = 0.55,
	FlipStagger = 0.24, -- delay between each card flipping face up
	ExitDuration = 0.5,

	-- Interaction --------------------------------------------------------
	MaxTilt = math.rad(15), -- how far a card leans toward the cursor
	TiltSmoothing = 10, -- higher = snappier tilt
	HoverPop = 0.5, -- studs a hovered card moves toward the camera
	HoverScale = 1.06,
	HoverLift = 0.25, -- studs a hovered card rises

	-- Sounds (leave "" to stay silent) -----------------------------------
	Sounds = {
		Roll = "",
		Flip = "",
		Select = "",
		Rare = "",
	},
}

return table.freeze(Config)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">Rarities</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rarities
	Ordered from most common to rarest. `Weight` is a relative number, not a
	percent - the roll math normalises it, so you can add a tier without
	rebalancing the others.
]]

export type Rarity = {
	Id: string,
	Name: string,
	Weight: number,
	Color: Color3, -- border / accent
	TextColor: Color3, -- rarity label
	GlowColor: Color3, -- PointLight + hover highlight
	GlowBrightness: number,
	RevealDelay: number, -- extra suspense before this card flips
	Sparkle: boolean, -- particles on reveal
	Rank: number, -- filled in below, 1 = most common
}

local list: { Rarity } = {
	{
		Id = "Common",
		Name = "COMMON",
		Weight = 1000,
		Color = Color3.fromRGB(168, 172, 180),
		TextColor = Color3.fromRGB(226, 229, 235),
		GlowColor = Color3.fromRGB(180, 186, 198),
		GlowBrightness = 0.6,
		RevealDelay = 0,
		Sparkle = false,
		Rank = 0,
	},
	{
		Id = "Uncommon",
		Name = "UNCOMMON",
		Weight = 520,
		Color = Color3.fromRGB(80, 214, 120),
		TextColor = Color3.fromRGB(140, 245, 170),
		GlowColor = Color3.fromRGB(70, 220, 120),
		GlowBrightness = 0.9,
		RevealDelay = 0.05,
		Sparkle = false,
		Rank = 0,
	},
	{
		Id = "Rare",
		Name = "RARE",
		Weight = 220,
		Color = Color3.fromRGB(70, 150, 255),
		TextColor = Color3.fromRGB(135, 190, 255),
		GlowColor = Color3.fromRGB(70, 150, 255),
		GlowBrightness = 1.2,
		RevealDelay = 0.12,
		Sparkle = false,
		Rank = 0,
	},
	{
		Id = "Epic",
		Name = "EPIC",
		Weight = 90,
		Color = Color3.fromRGB(168, 85, 247),
		TextColor = Color3.fromRGB(206, 152, 255),
		GlowColor = Color3.fromRGB(168, 85, 247),
		GlowBrightness = 1.7,
		RevealDelay = 0.22,
		Sparkle = true,
		Rank = 0,
	},
	{
		Id = "Legendary",
		Name = "LEGENDARY",
		Weight = 22,
		Color = Color3.fromRGB(240, 190, 40),
		TextColor = Color3.fromRGB(255, 214, 92),
		GlowColor = Color3.fromRGB(255, 190, 40),
		GlowBrightness = 2.4,
		RevealDelay = 0.4,
		Sparkle = true,
		Rank = 0,
	},
	{
		Id = "Mythic",
		Name = "MYTHIC",
		Weight = 4,
		Color = Color3.fromRGB(255, 70, 110),
		TextColor = Color3.fromRGB(255, 130, 165),
		GlowColor = Color3.fromRGB(255, 60, 110),
		GlowBrightness = 3,
		RevealDelay = 0.6,
		Sparkle = true,
		Rank = 0,
	},
}

local Rarities = {}

Rarities.List = list
Rarities.ById = {} :: { [string]: Rarity }

local totalWeight = 0
for index, rarity in list do
	rarity.Rank = index
	totalWeight += rarity.Weight
	Rarities.ById[rarity.Id] = rarity
end

Rarities.TotalWeight = totalWeight

function Rarities.get(id: string): Rarity
	local rarity = Rarities.ById[id]
	assert(rarity, `unknown rarity "{id}"`)
	return rarity
end

-- Chance of a single card landing on this tier, as a percentage.
function Rarities.chancePercent(id: string): number
	return Rarities.get(id).Weight / totalWeight * 100
end

-- "1 in N" phrasing for the odds panel.
function Rarities.oneInN(id: string): number
	return totalWeight / Rarities.get(id).Weight
end

return Rarities
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX4">
			<Properties>
				<string name="Name">Cards</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Cards
	The catalogue. Add an entry and it is instantly rollable - nothing else
	needs editing.

	Icon: a Roblox image id ("rbxassetid://123..."). Leave it "" and the card
	draws a large letter glyph instead, so the system works before art exists.
]]

local Rarities = require(script.Parent.Rarities)

export type Card = {
	Id: string,
	Name: string,
	Rarity: string,
	Icon: string,
	Flavor: string,
}

local list: { Card } = {
	-- Common ------------------------------------------------------------
	{ Id = "emberstrike", Name = "Emberstrike", Rarity = "Common", Icon = "", Flavor = "Why was the rock so confident? It was rock solid." },
	{ Id = "oak_cudgel", Name = "Oak Cudgel", Rarity = "Common", Icon = "", Flavor = "Simple, heavy, and entirely without opinions." },
	{ Id = "tin_buckler", Name = "Tin Buckler", Rarity = "Common", Icon = "", Flavor = "Dents are just the shield remembering things." },
	{ Id = "field_dagger", Name = "Field Dagger", Rarity = "Common", Icon = "", Flavor = "Sharp enough for bread. Mostly used for bread." },

	-- Uncommon ----------------------------------------------------------
	{ Id = "frostbite", Name = "Frostbite", Rarity = "Uncommon", Icon = "", Flavor = "It does not cut. It convinces things to stop moving." },
	{ Id = "gale_edge", Name = "Gale Edge", Rarity = "Uncommon", Icon = "", Flavor = "Swing it twice and the second one arrives first." },
	{ Id = "verdant_totem", Name = "Verdant Totem", Rarity = "Uncommon", Icon = "", Flavor = "Grows one leaf for every fight you survive." },

	-- Rare --------------------------------------------------------------
	{ Id = "tidecaller", Name = "Tidecaller", Rarity = "Rare", Icon = "", Flavor = "The sea answers. It is not always polite about it." },
	{ Id = "stormpiercer", Name = "Stormpiercer", Rarity = "Rare", Icon = "", Flavor = "Lightning takes the shortest path. This is the path." },
	{ Id = "ironwake", Name = "Ironwake", Rarity = "Rare", Icon = "", Flavor = "Leaves a trail even the ground remembers." },

	-- Epic --------------------------------------------------------------
	{ Id = "rocksplitter", Name = "Rocksplitter", Rarity = "Epic", Icon = "", Flavor = "What did the stone say to the pickaxe? \"I'm stoned.\"" },
	{ Id = "voidlash", Name = "Voidlash", Rarity = "Epic", Icon = "", Flavor = "Cracks the air. The air files a complaint." },
	{ Id = "sunspire", Name = "Sunspire", Rarity = "Epic", Icon = "", Flavor = "Warm to hold. Warmer to be hit by." },

	-- Legendary ---------------------------------------------------------
	{ Id = "the_devourer", Name = "The Devourer", Rarity = "Legendary", Icon = "", Flavor = "It's not hungry. It's just always hungry." },
	{ Id = "kingsfall", Name = "Kingsfall", Rarity = "Legendary", Icon = "", Flavor = "Crowns are only heavy until this removes them." },

	-- Mythic ------------------------------------------------------------
	{ Id = "worldroot", Name = "Worldroot", Rarity = "Mythic", Icon = "", Flavor = "Older than the map it is standing on." },
}

local Cards = {}

Cards.List = list
Cards.ById = {} :: { [string]: Card }
Cards.ByRarity = {} :: { [string]: { Card } }

for _, card in list do
	assert(Cards.ById[card.Id] == nil, `duplicate card id "{card.Id}"`)
	Rarities.get(card.Rarity) -- errors early on a typo'd rarity
	Cards.ById[card.Id] = card

	local bucket = Cards.ByRarity[card.Rarity]
	if not bucket then
		bucket = {}
		Cards.ByRarity[card.Rarity] = bucket
	end
	table.insert(bucket, card)
end

function Cards.get(id: string): Card?
	return Cards.ById[id]
end

-- Every rarity tier needs at least one card or the roll can dead-end.
for _, rarity in Rarities.List do
	assert(Cards.ByRarity[rarity.Id], `rarity "{rarity.Id}" has no cards`)
end

return Cards
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX5">
			<Properties>
				<string name="Name">RollLogic</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RollLogic
	Pure functions - no Instances, no yielding. The server owns the Random
	object, so the client can never influence an outcome.
]]

local Cards = require(script.Parent.Cards)
local Config = require(script.Parent.Config)
local Rarities = require(script.Parent.Rarities)

type Card = Cards.Card
type Rarity = Rarities.Rarity

local RollLogic = {}

-- Weighted pick across every rarity tier.
function RollLogic.pickRarity(rng: Random): Rarity
	local roll = rng:NextNumber(0, Rarities.TotalWeight)
	local running = 0
	for _, rarity in Rarities.List do
		running += rarity.Weight
		if roll <= running then
			return rarity
		end
	end
	-- Float rounding can overshoot the last bucket by a hair.
	return Rarities.List[#Rarities.List]
end

function RollLogic.pickCardOfRarity(rng: Random, rarityId: string): Card
	local pool = Cards.ByRarity[rarityId]
	assert(pool and #pool > 0, `no cards for rarity "{rarityId}"`)
	return pool[rng:NextInteger(1, #pool)]
end

function RollLogic.pickCard(rng: Random): Card
	return RollLogic.pickCardOfRarity(rng, RollLogic.pickRarity(rng).Id)
end

--[[
	Deals one hand.

	pityCounter: rolls since the player last saw Config.PityMinimumRarity or
	better. When it reaches Config.PityRolls, one card in the hand is upgraded.

	Returns the hand and the new pity counter.
]]
function RollLogic.rollHand(rng: Random, pityCounter: number): ({ Card }, number)
	local hand: { Card } = {}
	for _ = 1, Config.CardsPerRoll do
		table.insert(hand, RollLogic.pickCard(rng))
	end

	local minRank = Rarities.get(Config.PityMinimumRarity).Rank
	local best = 0
	for _, card in hand do
		best = math.max(best, Rarities.get(card.Rarity).Rank)
	end

	local pityActive = Config.PityRolls > 0
	if pityActive and best < minRank and pityCounter + 1 >= Config.PityRolls then
		-- Upgrade one random slot to exactly the pity floor.
		local slot = rng:NextInteger(1, #hand)
		hand[slot] = RollLogic.pickCardOfRarity(rng, Config.PityMinimumRarity)
		best = minRank
	end

	local nextPity = if best >= minRank then 0 else pityCounter + 1
	return hand, nextPity
end

return RollLogic
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX6">
			<Properties>
				<string name="Name">Remotes</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Remotes
	One place that names the network surface. The server creates the objects,
	the client waits for them.

	client -> server : RequestRoll()            ask for a new hand
	                   SelectCard(rollId, slot) keep one card from the hand
	server -> client : RollResult(rollId, {cardId})
	                   RollRejected(reason, retryAfterSeconds)
	                   SelectionResult(ok, cardId, slot)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "CardRemotes"
local EVENT_NAMES = {
	"RequestRoll",
	"RollResult",
	"RollRejected",
	"SelectCard",
	"SelectionResult",
}

export type Remotes = {
	RequestRoll: RemoteEvent,
	RollResult: RemoteEvent,
	RollRejected: RemoteEvent,
	SelectCard: RemoteEvent,
	SelectionResult: RemoteEvent,
}

local cached: Remotes? = nil

local function build(): Remotes
	local remotes = {}

	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end

		for _, name in EVENT_NAMES do
			local event = folder:FindFirstChild(name)
			if not event then
				event = Instance.new("RemoteEvent")
				event.Name = name
				event.Parent = folder
			end
			remotes[name] = event
		end
	else
		local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
		for _, name in EVENT_NAMES do
			remotes[name] = folder:WaitForChild(name)
		end
	end

	return (remotes :: any) :: Remotes
end

return {
	get = function(): Remotes
		if not cached then
			cached = build()
		end
		return (cached :: any) :: Remotes
	end,
}
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
