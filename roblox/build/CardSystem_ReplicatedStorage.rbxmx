<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBX1">
		<Properties>
			<string name="Name">CardSystem</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">Cards</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Cards
	The catalogue. Add an entry and it is instantly rollable and shows up in the
	inventory - nothing else needs editing.

	Icon: a Roblox image id ("rbxassetid://123..."). Leave it "" and the card
	draws a large letter glyph instead, so the system works before art exists.
	Category: must match an id in Categories.luau. It drives the inventory tabs.
	Flavor: the italic line on the card face.
	Description: the plain line in the inventory tooltip and the showcase.
]]

local Categories = require(script.Parent.Categories)
local Rarities = require(script.Parent.Rarities)

export type Card = {
	Id: string,
	Name: string,
	Rarity: string,
	Category: string,
	Icon: string,
	Flavor: string,
	Description: string,
}

local list: { Card } = {
	-- Weapons -----------------------------------------------------------
	{ Id = "emberstrike", Name = "Emberstrike", Rarity = "Common", Category = "Weapons", Icon = "", Flavor = "Why was the rock so confident? It was rock solid.", Description = "A starter blade that never quite cools down." },
	{ Id = "oak_cudgel", Name = "Oak Cudgel", Rarity = "Common", Category = "Weapons", Icon = "", Flavor = "Simple, heavy, and entirely without opinions.", Description = "Heavy, blunt, and impossible to break." },
	{ Id = "field_dagger", Name = "Field Dagger", Rarity = "Common", Category = "Weapons", Icon = "", Flavor = "Sharp enough for bread. Mostly used for bread.", Description = "Quick strikes, short reach." },
	{ Id = "frostbite", Name = "Frostbite", Rarity = "Uncommon", Category = "Weapons", Icon = "", Flavor = "It does not cut. It convinces things to stop moving.", Description = "Slows whatever it touches." },
	{ Id = "gale_edge", Name = "Gale Edge", Rarity = "Uncommon", Category = "Weapons", Icon = "", Flavor = "Swing it twice and the second one arrives first.", Description = "Swings faster the longer you hold it." },
	{ Id = "stormpiercer", Name = "Stormpiercer", Rarity = "Rare", Category = "Weapons", Icon = "", Flavor = "Lightning takes the shortest path. This is the path.", Description = "Calls down a strike on a critical hit." },
	{ Id = "ironwake", Name = "Ironwake", Rarity = "Rare", Category = "Weapons", Icon = "", Flavor = "Leaves a trail even the ground remembers.", Description = "Leaves a damaging trail behind you." },
	{ Id = "rocksplitter", Name = "Rocksplitter", Rarity = "Epic", Category = "Weapons", Icon = "", Flavor = "What did the stone say to the pickaxe? \"I'm stoned.\"", Description = "Breaks armour and terrain alike." },
	{ Id = "voidlash", Name = "Voidlash", Rarity = "Epic", Category = "Weapons", Icon = "", Flavor = "Cracks the air. The air files a complaint.", Description = "Pulls distant enemies toward you." },
	{ Id = "kingsfall", Name = "Kingsfall", Rarity = "Legendary", Category = "Weapons", Icon = "", Flavor = "Crowns are only heavy until this removes them.", Description = "Deals bonus damage to bosses." },

	-- Relics ------------------------------------------------------------
	{ Id = "ashen_idol", Name = "Ashen Idol", Rarity = "Common", Category = "Relics", Icon = "", Flavor = "Still warm. It has been still warm for centuries.", Description = "A small passive boost to fire damage." },
	{ Id = "verdant_totem", Name = "Verdant Totem", Rarity = "Uncommon", Category = "Relics", Icon = "", Flavor = "Grows one leaf for every fight you survive.", Description = "Regenerates health out of combat." },
	{ Id = "tidecaller", Name = "Tidecaller", Rarity = "Rare", Category = "Relics", Icon = "", Flavor = "The sea answers. It is not always polite about it.", Description = "Grants a water shield when low." },
	{ Id = "sunspire", Name = "Sunspire", Rarity = "Epic", Category = "Relics", Icon = "", Flavor = "Warm to hold. Warmer to be hit by.", Description = "Burns everything within a short radius." },
	{ Id = "the_devourer", Name = "The Devourer", Rarity = "Legendary", Category = "Relics", Icon = "", Flavor = "It's not hungry. It's just always hungry.", Description = "Heals you for part of the damage you deal." },
	{ Id = "worldroot", Name = "Worldroot", Rarity = "Mythic", Category = "Relics", Icon = "", Flavor = "Older than the map it is standing on.", Description = "Boosts every other relic you carry." },

	-- Trinkets ----------------------------------------------------------
	{ Id = "tin_buckler", Name = "Tin Buckler", Rarity = "Common", Category = "Trinkets", Icon = "", Flavor = "Dents are just the shield remembering things.", Description = "Blocks one hit every few seconds." },
	{ Id = "glass_charm", Name = "Glass Charm", Rarity = "Common", Category = "Trinkets", Icon = "", Flavor = "Beautiful. Fragile. Mostly beautiful.", Description = "More damage dealt, more damage taken." },
	{ Id = "luck_coin", Name = "Luck Coin", Rarity = "Uncommon", Category = "Trinkets", Icon = "", Flavor = "Lands on its edge more often than it should.", Description = "Slightly better roll luck while held." },
	{ Id = "ember_ring", Name = "Ember Ring", Rarity = "Rare", Category = "Trinkets", Icon = "", Flavor = "Keeps one spark from every fire it has seen.", Description = "Your first hit each fight burns." },

	-- Tickets -----------------------------------------------------------
	{ Id = "summon_pass", Name = "Summon Pass", Rarity = "Uncommon", Category = "Tickets", Icon = "", Flavor = "One free look at whatever the machine has today.", Description = "Can be used for a free roll." },
	{ Id = "raid_ticket", Name = "Raid Ticket", Rarity = "Rare", Category = "Tickets", Icon = "", Flavor = "Admits one. Return trip not guaranteed.", Description = "Can be used in Raids." },
	{ Id = "golden_voucher", Name = "Golden Voucher", Rarity = "Epic", Category = "Tickets", Icon = "", Flavor = "Worth exactly as much as someone will give you.", Description = "Trades for high tier rewards." },
	{ Id = "eclipse_seal", Name = "Eclipse Seal", Rarity = "Legendary", Category = "Tickets", Icon = "", Flavor = "Opens the door that is only there sometimes.", Description = "Unlocks the eclipse event." },
}

local Cards = {}

Cards.List = list
Cards.ById = {} :: { [string]: Card }
Cards.ByRarity = {} :: { [string]: { Card } }
Cards.ByCategory = {} :: { [string]: { Card } }

for _, card in list do
	assert(Cards.ById[card.Id] == nil, `duplicate card id "{card.Id}"`)
	Rarities.get(card.Rarity) -- errors early on a typo'd rarity
	assert(Categories.exists(card.Category), `card "{card.Id}" has unknown category "{card.Category}"`)
	Cards.ById[card.Id] = card

	local byRarity = Cards.ByRarity[card.Rarity]
	if not byRarity then
		byRarity = {}
		Cards.ByRarity[card.Rarity] = byRarity
	end
	table.insert(byRarity, card)

	local byCategory = Cards.ByCategory[card.Category]
	if not byCategory then
		byCategory = {}
		Cards.ByCategory[card.Category] = byCategory
	end
	table.insert(byCategory, card)
end

function Cards.get(id: string): Card?
	return Cards.ById[id]
end

-- Every tier needs at least one card or the roll can dead-end.
for _, rarity in Rarities.List do
	assert(Cards.ByRarity[rarity.Id], `rarity "{rarity.Id}" has no cards`)
end

-- An empty tab would just look broken.
for _, category in Categories.List do
	assert(Cards.ByCategory[category.Id], `category "{category.Id}" has no cards`)
end

return Cards
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">Categories</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Categories
	The inventory tab strip is built from this list. Add an entry here, put the
	same id on a card in Cards.luau, and the tab appears with no other edits.

	"All" is implicit and always first.
]]

export type Category = {
	Id: string,
	Name: string,
	Color: Color3,
}

local Categories = {}

Categories.AllId = "All"
Categories.AllColor = Color3.fromRGB(79, 195, 247)

Categories.List = {
	{ Id = "Weapons", Name = "Weapons", Color = Color3.fromRGB(255, 196, 40) },
	{ Id = "Relics", Name = "Relics", Color = Color3.fromRGB(255, 152, 40) },
	{ Id = "Trinkets", Name = "Trinkets", Color = Color3.fromRGB(120, 214, 60) },
	{ Id = "Tickets", Name = "Tickets", Color = Color3.fromRGB(86, 200, 90) },
} :: { Category }

Categories.ById = {} :: { [string]: Category }
for _, category in Categories.List do
	Categories.ById[category.Id] = category
end

function Categories.exists(id: string): boolean
	return id == Categories.AllId or Categories.ById[id] ~= nil
end

return Categories
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX4">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Config
	Every tunable number for the card system lives here.
	Shared between server and client, so both agree on timings and limits.
]]

local Config = {
	-- Roll rules -------------------------------------------------------
	CardsPerRoll = 3, -- how many cards are dealt each roll
	RollCooldown = 2, -- seconds a player must wait between rolls
	PityRolls = 12, -- rolls without a Rare+ before one is guaranteed (0 disables)
	PityMinimumRarity = "Rare",

	-- Card geometry (studs) --------------------------------------------
	CardSize = Vector3.new(3.8, 5.3, 0.16),
	CardSpacing = 4.3, -- centre-to-centre distance between cards
	CameraDistance = 9, -- how far in front of the camera the hand spawns
	CameraHeightOffset = 0.4, -- lift the hand slightly above eye level
	PixelsPerStud = 110, -- SurfaceGui resolution

	-- Animation ---------------------------------------------------------
	EnterDuration = 0.45,
	EnterStagger = 0.13, -- delay between each card entering
	EnterDrop = 4, -- studs the card rises from
	EnterScale = 0.82, -- starting size multiplier
	FlipDuration = 0.55,
	FlipStagger = 0.24, -- delay between each card flipping face up
	ExitDuration = 0.5,

	-- Interaction --------------------------------------------------------
	MaxTilt = math.rad(15), -- how far a card leans toward the cursor
	TiltSmoothing = 10, -- higher = snappier tilt
	HoverPop = 0.5, -- studs a hovered card moves toward the camera
	HoverScale = 1.06,
	HoverLift = 0.25, -- studs a hovered card rises

	-- Screen layout (pixels, authored against a 900px tall viewport) ------
	Layout = {
		XpBarHeight = 24,
		XpBarWidth = 940,
		XpBarBottom = 10, -- gap from the bottom edge
		HotbarSlot = 84,
		HotbarGap = 10,
		HotbarBottom = 44, -- sits above the xp bar
		RollBottom = 150, -- roll button clears the hotbar
		SideButton = 62, -- the inventory button on the left edge
	},

	-- Hotbar --------------------------------------------------------------
	Hotbar = {
		Slots = 6,
		-- Level needed to use each slot, in order. Same shape as the
		-- reference UI: three open, three gated.
		LevelGates = { 1, 1, 1, 25, 50, 100 },
	},

	-- Inventory -----------------------------------------------------------
	Inventory = {
		Columns = 5,
		VisibleRows = 3,
		SlotSize = 92,
		SlotGap = 8,
		PanelPadding = 12,
	},

	-- Showcase -------------------------------------------------------------
	Showcase = {
		Distance = 8,
		Size = Vector3.new(5.4, 3.4, 0.2),
		SpinSpeed = 0.35, -- radians per second
		BobHeight = 0.15,
		BobSpeed = 1.6,
	},

	-- The stock Roblox backpack sits exactly where our hotbar goes.
	HideDefaultBackpack = true,

	-- Keys -----------------------------------------------------------------
	Keys = {
		Roll = Enum.KeyCode.R,
		Inventory = Enum.KeyCode.E,
	},

	-- Sounds (leave "" to stay silent) -----------------------------------
	Sounds = {
		Roll = "",
		Flip = "",
		Select = "",
		Rare = "",
		Open = "",
		Close = "",
	},
}

return table.freeze(Config)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX5">
			<Properties>
				<string name="Name">Levels</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Levels
	XP curve behind the bar under the hotbar, and the gates on the locked
	hotbar slots.

	The curve is quadratic: early levels come fast, later ones stretch out.
]]

local Rarities = require(script.Parent.Rarities)

local Levels = {}

Levels.MaxLevel = 200

-- XP needed to go from `level` to `level + 1`.
function Levels.xpForNext(level: number): number
	local n = math.max(1, math.floor(level))
	return 15 + (n - 1) * 10 + math.floor((n - 1) ^ 2 * 0.6)
end

-- Total XP banked at the start of `level`.
function Levels.totalXpForLevel(level: number): number
	local total = 0
	for n = 1, math.max(1, math.floor(level)) - 1 do
		total += Levels.xpForNext(n)
	end
	return total
end

export type Progress = {
	Level: number,
	IntoLevel: number,
	Needed: number,
	Fraction: number,
}

-- Splits a total XP figure into the level and the progress inside it.
function Levels.progress(totalXp: number): Progress
	local remaining = math.max(0, math.floor(totalXp))
	local level = 1
	while level < Levels.MaxLevel do
		local needed = Levels.xpForNext(level)
		if remaining < needed then
			break
		end
		remaining -= needed
		level += 1
	end

	local needed = if level >= Levels.MaxLevel then 0 else Levels.xpForNext(level)
	return {
		Level = level,
		IntoLevel = remaining,
		Needed = needed,
		Fraction = if needed > 0 then math.clamp(remaining / needed, 0, 1) else 1,
	}
end

-- XP paid out for keeping a card of this rarity.
function Levels.xpForRarity(rarityId: string): number
	local rarity = Rarities.get(rarityId)
	return 5 + (rarity.Rank - 1) * 6
end

return Levels
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX6">
			<Properties>
				<string name="Name">Rarities</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rarities
	Ordered from most common to rarest. `Weight` is a relative number, not a
	percent - the roll math normalises it, so you can add a tier without
	rebalancing the others.
]]

export type Rarity = {
	Id: string,
	Name: string,
	Weight: number,
	Color: Color3, -- border / accent
	TextColor: Color3, -- rarity label
	GlowColor: Color3, -- PointLight + hover highlight
	GlowBrightness: number,
	RevealDelay: number, -- extra suspense before this card flips
	Sparkle: boolean, -- particles on reveal
	Rank: number, -- filled in below, 1 = most common
}

local list: { Rarity } = {
	{
		Id = "Common",
		Name = "COMMON",
		Weight = 1000,
		Color = Color3.fromRGB(168, 172, 180),
		TextColor = Color3.fromRGB(226, 229, 235),
		GlowColor = Color3.fromRGB(180, 186, 198),
		GlowBrightness = 0.6,
		RevealDelay = 0,
		Sparkle = false,
		Rank = 0,
	},
	{
		Id = "Uncommon",
		Name = "UNCOMMON",
		Weight = 520,
		Color = Color3.fromRGB(80, 214, 120),
		TextColor = Color3.fromRGB(140, 245, 170),
		GlowColor = Color3.fromRGB(70, 220, 120),
		GlowBrightness = 0.9,
		RevealDelay = 0.05,
		Sparkle = false,
		Rank = 0,
	},
	{
		Id = "Rare",
		Name = "RARE",
		Weight = 220,
		Color = Color3.fromRGB(70, 150, 255),
		TextColor = Color3.fromRGB(135, 190, 255),
		GlowColor = Color3.fromRGB(70, 150, 255),
		GlowBrightness = 1.2,
		RevealDelay = 0.12,
		Sparkle = false,
		Rank = 0,
	},
	{
		Id = "Epic",
		Name = "EPIC",
		Weight = 90,
		Color = Color3.fromRGB(168, 85, 247),
		TextColor = Color3.fromRGB(206, 152, 255),
		GlowColor = Color3.fromRGB(168, 85, 247),
		GlowBrightness = 1.7,
		RevealDelay = 0.22,
		Sparkle = true,
		Rank = 0,
	},
	{
		Id = "Legendary",
		Name = "LEGENDARY",
		Weight = 22,
		Color = Color3.fromRGB(240, 190, 40),
		TextColor = Color3.fromRGB(255, 214, 92),
		GlowColor = Color3.fromRGB(255, 190, 40),
		GlowBrightness = 2.4,
		RevealDelay = 0.4,
		Sparkle = true,
		Rank = 0,
	},
	{
		Id = "Mythic",
		Name = "MYTHIC",
		Weight = 4,
		Color = Color3.fromRGB(255, 70, 110),
		TextColor = Color3.fromRGB(255, 130, 165),
		GlowColor = Color3.fromRGB(255, 60, 110),
		GlowBrightness = 3,
		RevealDelay = 0.6,
		Sparkle = true,
		Rank = 0,
	},
}

local Rarities = {}

Rarities.List = list
Rarities.ById = {} :: { [string]: Rarity }

local totalWeight = 0
for index, rarity in list do
	rarity.Rank = index
	totalWeight += rarity.Weight
	Rarities.ById[rarity.Id] = rarity
end

Rarities.TotalWeight = totalWeight

function Rarities.get(id: string): Rarity
	local rarity = Rarities.ById[id]
	assert(rarity, `unknown rarity "{id}"`)
	return rarity
end

-- Chance of a single card landing on this tier, as a percentage.
function Rarities.chancePercent(id: string): number
	return Rarities.get(id).Weight / totalWeight * 100
end

-- "1 in N" phrasing for the odds panel.
function Rarities.oneInN(id: string): number
	return totalWeight / Rarities.get(id).Weight
end

return Rarities
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX7">
			<Properties>
				<string name="Name">Remotes</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Remotes
	One place that names the network surface. The server creates the objects,
	the client waits for them.

	client -> server : RequestRoll()             ask for a new hand
	                   SelectCard(rollId, slot)  keep one card from the hand
	                   EquipCard(slot, cardId)   put a card on the hotbar
	                                             (cardId nil clears the slot)
	server -> client : RollResult(rollId, {cardId})
	                   RollRejected(reason, retryAfterSeconds)
	                   SelectionResult(ok, cardId, slot)
	                   ProfileSync(profile)      counts, xp and hotbar
	                   Notice(text, isError)     one-line toast
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "CardRemotes"
local EVENT_NAMES = {
	"RequestRoll",
	"RollResult",
	"RollRejected",
	"SelectCard",
	"SelectionResult",
	"EquipCard",
	"ProfileSync",
	"Notice",
}

export type Remotes = {
	RequestRoll: RemoteEvent,
	RollResult: RemoteEvent,
	RollRejected: RemoteEvent,
	SelectCard: RemoteEvent,
	SelectionResult: RemoteEvent,
	EquipCard: RemoteEvent,
	ProfileSync: RemoteEvent,
	Notice: RemoteEvent,
}

local cached: Remotes? = nil

local function build(): Remotes
	local remotes = {}

	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end

		for _, name in EVENT_NAMES do
			local event = folder:FindFirstChild(name)
			if not event then
				event = Instance.new("RemoteEvent")
				event.Name = name
				event.Parent = folder
			end
			remotes[name] = event
		end
	else
		local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
		for _, name in EVENT_NAMES do
			remotes[name] = folder:WaitForChild(name)
		end
	end

	return (remotes :: any) :: Remotes
end

return {
	get = function(): Remotes
		if not cached then
			cached = build()
		end
		return (cached :: any) :: Remotes
	end,
}
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX8">
			<Properties>
				<string name="Name">RollLogic</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RollLogic
	Pure functions - no Instances, no yielding. The server owns the Random
	object, so the client can never influence an outcome.
]]

local Cards = require(script.Parent.Cards)
local Config = require(script.Parent.Config)
local Rarities = require(script.Parent.Rarities)

type Card = Cards.Card
type Rarity = Rarities.Rarity

local RollLogic = {}

-- Weighted pick across every rarity tier.
function RollLogic.pickRarity(rng: Random): Rarity
	local roll = rng:NextNumber(0, Rarities.TotalWeight)
	local running = 0
	for _, rarity in Rarities.List do
		running += rarity.Weight
		if roll <= running then
			return rarity
		end
	end
	-- Float rounding can overshoot the last bucket by a hair.
	return Rarities.List[#Rarities.List]
end

function RollLogic.pickCardOfRarity(rng: Random, rarityId: string): Card
	local pool = Cards.ByRarity[rarityId]
	assert(pool and #pool > 0, `no cards for rarity "{rarityId}"`)
	return pool[rng:NextInteger(1, #pool)]
end

function RollLogic.pickCard(rng: Random): Card
	return RollLogic.pickCardOfRarity(rng, RollLogic.pickRarity(rng).Id)
end

--[[
	Deals one hand.

	pityCounter: rolls since the player last saw Config.PityMinimumRarity or
	better. When it reaches Config.PityRolls, one card in the hand is upgraded.

	Returns the hand and the new pity counter.
]]
function RollLogic.rollHand(rng: Random, pityCounter: number): ({ Card }, number)
	local hand: { Card } = {}
	for _ = 1, Config.CardsPerRoll do
		table.insert(hand, RollLogic.pickCard(rng))
	end

	local minRank = Rarities.get(Config.PityMinimumRarity).Rank
	local best = 0
	for _, card in hand do
		best = math.max(best, Rarities.get(card.Rarity).Rank)
	end

	local pityActive = Config.PityRolls > 0
	if pityActive and best < minRank and pityCounter + 1 >= Config.PityRolls then
		-- Upgrade one random slot to exactly the pity floor.
		local slot = rng:NextInteger(1, #hand)
		hand[slot] = RollLogic.pickCardOfRarity(rng, Config.PityMinimumRarity)
		best = minRank
	end

	local nextPity = if best >= minRank then 0 else pityCounter + 1
	return hand, nextPity
end

return RollLogic
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX9">
			<Properties>
				<string name="Name">Theme</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Theme
	One place for the look: palette, font, and the small builders every panel
	uses. Keeping it here means the roll cards, the inventory and the hotbar
	cannot drift apart.

	The style is the chunky cartoon game-UI look: near-black panels, a thick
	saturated border, bold rounded text with a heavy black outline, and gold
	count numbers.
]]

local Theme = {}

Theme.Font = Enum.Font.FredokaOne
Theme.FontFallback = Enum.Font.GothamBold

Theme.Colors = {
	PanelBody = Color3.fromRGB(17, 18, 24),
	PanelBodyDeep = Color3.fromRGB(10, 11, 15),
	PanelBorder = Color3.fromRGB(86, 224, 34),
	PanelBorderDark = Color3.fromRGB(44, 130, 14),
	HeaderLight = Color3.fromRGB(140, 240, 60),
	HeaderDark = Color3.fromRGB(70, 190, 22),
	Text = Color3.fromRGB(255, 255, 255),
	TextDim = Color3.fromRGB(186, 192, 204),
	Outline = Color3.fromRGB(0, 0, 0),
	Count = Color3.fromRGB(255, 178, 24),
	Close = Color3.fromRGB(228, 46, 46),
	CloseDark = Color3.fromRGB(140, 20, 20),
	SlotEmpty = Color3.fromRGB(24, 26, 33),
	SlotLocked = Color3.fromRGB(20, 21, 27),
	Search = Color3.fromRGB(16, 17, 22),
	XpTrack = Color3.fromRGB(20, 21, 27),
	XpFillA = Color3.fromRGB(150, 70, 255),
	XpFillB = Color3.fromRGB(70, 130, 255),
	Equip = Color3.fromRGB(70, 180, 255),
	Danger = Color3.fromRGB(228, 78, 78),
}

--[[
	Optional tiling dot texture for the halftone pattern the reference UI uses
	behind every slot. Upload one and paste its id here to get that exact look;
	while it is empty the slots fall back to a two-stop gradient, which reads
	almost the same at slot size.
]]
Theme.DotTexture = ""
Theme.DotTileSize = UDim2.fromOffset(16, 16)
Theme.DotTransparency = 0.86

-- Instance helper ---------------------------------------------------------
function Theme.make(className: string, props: { [string]: any }, children: { any }?): any
	local instance = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	-- Parent last so the engine does not replicate every later property.
	if parent then
		instance.Parent = parent
	end
	return instance
end

local make = Theme.make

--[[
	corner and gradient return `any` on purpose. They are almost always the
	first entry in a mixed children array, and Luau types an array literal from
	its first element - a precise return here would make every
	`{ Theme.corner(8), Theme.stroke(...), ... }` fail to type check.
]]
function Theme.corner(radius: number): any
	return make("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function Theme.stroke(color: Color3, thickness: number, transparency: number?): UIStroke
	return make("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

function Theme.gradient(top: Color3, bottom: Color3, rotation: number?): any
	return make("UIGradient", {
		Rotation = rotation or 90,
		Color = ColorSequence.new(top, bottom),
	})
end

-- Bold text with the heavy black outline the reference UI uses everywhere.
function Theme.label(props: { [string]: any }, outlineThickness: number?): TextLabel
	local merged: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
	}
	for key, value in props do
		merged[key] = value
	end
	return make("TextLabel", merged, {
		Theme.stroke(Theme.Colors.Outline, outlineThickness or 2.5),
	})
end

-- The dotted overlay, or nothing when no texture is configured.
function Theme.dots(zindex: number?): ImageLabel?
	if Theme.DotTexture == "" then
		return nil
	end
	return make("ImageLabel", {
		Name = "Dots",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Image = Theme.DotTexture,
		ImageTransparency = Theme.DotTransparency,
		ScaleType = Enum.ScaleType.Tile,
		TileSize = Theme.DotTileSize,
		ZIndex = zindex or 1,
	})
end

--[[
	A panel body: near-black, thick coloured border, rounded, with the dotted
	texture when one is set.
]]
function Theme.panel(props: { [string]: any }, borderColor: Color3?, children: { any }?): Frame
	local merged: { [string]: any } = {
		BackgroundColor3 = Theme.Colors.PanelBody,
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end

	local kids: { any } = {
		Theme.corner(12),
		Theme.stroke(borderColor or Theme.Colors.PanelBorder, 4),
		Theme.gradient(Theme.Colors.PanelBody, Theme.Colors.PanelBodyDeep),
	}
	local dots = Theme.dots()
	if dots then
		table.insert(kids, dots)
	end
	if children then
		for _, child in children do
			table.insert(kids, child)
		end
	end
	return make("Frame", merged, kids)
end

-- A coloured tab / action pill.
function Theme.pill(props: { [string]: any }, color: Color3, text: string): TextButton
	local merged: { [string]: any } = {
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end
	return make("TextButton", merged, {
		Theme.corner(8),
		Theme.gradient(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)),
		Theme.stroke(Theme.Colors.Outline, 2.5),
		Theme.label({
			Name = "Label",
			Size = UDim2.fromScale(1, 1),
			Text = text,
		}, 3),
	})
end

-- A chunky white padlock, drawn from parts so it needs no uploaded image.
function Theme.lockIcon(props: { [string]: any }): Frame
	local merged: { [string]: any } = {
		Name = "Lock",
		BackgroundTransparency = 1,
	}
	for key, value in props do
		merged[key] = value
	end
	return make("Frame", merged, {
		-- Shackle: a ring whose lower half is hidden behind the body.
		make("Frame", {
			Name = "Shackle",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.02),
			Size = UDim2.fromScale(0.52, 0.52),
			BackgroundTransparency = 1,
		}, {
			Theme.corner(999),
			Theme.stroke(Color3.new(1, 1, 1), 5),
		}),
		make("Frame", {
			Name = "Body",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 1),
			Size = UDim2.fromScale(0.78, 0.56),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, {
			Theme.corner(6),
			Theme.stroke(Theme.Colors.Outline, 2),
			make("Frame", {
				Name = "Keyhole",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.45),
				Size = UDim2.fromScale(0.2, 0.28),
				BackgroundColor3 = Color3.fromRGB(30, 30, 36),
				BorderSizePixel = 0,
			}, { Theme.corner(999) }),
		}),
	})
end

-- Magnifier for the search field, also drawn rather than uploaded.
function Theme.searchIcon(props: { [string]: any }): Frame
	local merged: { [string]: any } = {
		Name = "SearchIcon",
		BackgroundTransparency = 1,
	}
	for key, value in props do
		merged[key] = value
	end
	return make("Frame", merged, {
		make("Frame", {
			Name = "Ring",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.42, 0.42),
			Size = UDim2.fromScale(0.62, 0.62),
			BackgroundTransparency = 1,
		}, {
			Theme.corner(999),
			Theme.stroke(Theme.Colors.TextDim, 2.5),
		}),
		make("Frame", {
			Name = "Handle",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.74, 0.76),
			Size = UDim2.fromScale(0.3, 0.11),
			Rotation = 45,
			BackgroundColor3 = Theme.Colors.TextDim,
			BorderSizePixel = 0,
		}, { Theme.corner(999) }),
	})
end

-- Slot colours: saturated but dark enough for white text to sit on top.
function Theme.rarityBackdrop(color: Color3): (Color3, Color3)
	local black = Color3.new(0, 0, 0)
	return color:Lerp(black, 0.42), color:Lerp(black, 0.76)
end

--[[
	The tinted, bordered square every item sits in - used by both the hotbar
	and the inventory grid so they cannot drift apart.
]]
function Theme.slotFrame(props: { [string]: any }, color: Color3, children: { any }?): Frame
	local top, bottom = Theme.rarityBackdrop(color)
	local merged: { [string]: any } = {
		BackgroundColor3 = top,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}
	for key, value in props do
		merged[key] = value
	end

	local kids: { any } = {
		Theme.corner(10),
		Theme.gradient(top, bottom, 135),
		Theme.stroke(color, 3),
	}
	local dots = Theme.dots()
	if dots then
		table.insert(kids, dots)
	end
	if children then
		for _, child in children do
			table.insert(kids, child)
		end
	end
	return Theme.make("Frame", merged, kids)
end

--[[
	An item's picture. Falls back to the first letter of the name in the
	rarity colour when the card has no icon yet, so the layout still reads.
]]
function Theme.iconFor(name: string, icon: string, color: Color3, props: { [string]: any }): GuiObject
	if icon ~= "" then
		local merged: { [string]: any } = {
			Name = "Icon",
			BackgroundTransparency = 1,
			Image = icon,
			ScaleType = Enum.ScaleType.Fit,
		}
		for key, value in props do
			merged[key] = value
		end
		return Theme.make("ImageLabel", merged)
	end

	local merged: { [string]: any } = {
		Name = "Icon",
		Text = string.upper(string.sub(name, 1, 1)),
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.45),
	}
	for key, value in props do
		merged[key] = value
	end
	return Theme.label(merged, 3)
end

--[[
	Keeps offset-sized UI in proportion across screens. The reference layout is
	authored against a 900px tall viewport.
]]
function Theme.scaleFor(viewportY: number): number
	return math.clamp(viewportY / 900, 0.62, 1.3)
end

return Theme
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
