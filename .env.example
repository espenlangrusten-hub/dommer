# Copy to .env and fill in to enable "Sign in with Roblox".
# Create an OAuth 2.0 app at https://create.roblox.com/dashboard/credentials
#   - App type:      Public (PKCE, no client secret — this site is static)
#   - Scopes:        openid, profile
#   - Redirect URI:  must match exactly, e.g.
#                    https://espenlangrusten-hub.github.io/dommer/
#                    http://localhost:3000/   (for local dev)
#
# Without this value the site runs in demo mode (pick a username locally).
REACT_APP_ROBLOX_CLIENT_ID=

# --- Google AdSense (display ads in the sidebar) ---
# Publisher ID from https://adsense.google.com — the "ca-pub-0000000000000000"
# value. Leave blank and the ad slots render as placeholders.
REACT_APP_ADSENSE_CLIENT=
# Ad unit IDs (the numeric data-ad-slot of each unit you create).
REACT_APP_ADSENSE_SLOT_SIDEBAR=
REACT_APP_ADSENSE_SLOT_INLINE=
